// Prisma Schema for Sathapana Bank Lucky Draw Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole  @default(READ_ONLY)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  campaignsCreated  Campaign[]        @relation("CampaignCreator")
  campaignsApproved Campaign[]        @relation("CampaignApprover")
  campaignApprovals CampaignApproval[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

// ==================== REFRESH TOKEN ====================

model RefreshToken {
  id               String    @id @default(uuid())
  userId           String
  token            String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedByToken  String?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

enum UserRole {
  SUPER_ADMIN
  CAMPAIGN_MANAGER
  MARKETING_MANAGER
  DRAW_OPERATOR
  PRIZE_COORDINATOR
  COMPLIANCE_OFFICER
  READ_ONLY
}

// ==================== CAMPAIGN ====================

model Campaign {
  id                    String         @id @default(uuid())
  name                  String
  description           String?
  type                  CampaignType
  status                CampaignStatus @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  drawDate              DateTime
  eligibilityCriteria   Json           @default("{}")
  entryRules            Json           @default("[]")
  drawSettings          Json           @default("{}")
  termsAndConditions    String?
  notificationSettings  Json           @default("{}")
  metadata              Json           @default("{}")

  // Audit fields
  createdBy             String
  createdAt             DateTime       @default(now())
  updatedBy             String?
  updatedAt             DateTime       @updatedAt
  approvedBy            String?
  approvedAt            DateTime?

  // Approval / duplication workflow
  sourceCampaignId      String?
  submittedBy           String?
  submittedAt           DateTime?

  // Relations
  creator               User             @relation("CampaignCreator", fields: [createdBy], references: [id])
  approver              User?            @relation("CampaignApprover", fields: [approvedBy], references: [id])
  approvals             CampaignApproval[]
  entries               CustomerEntry[]
  prizes                Prize[]
  drawResults           DrawResult[]
  notifications         Notification[]

  @@index([status])
  @@index([type])
  @@index([startDate, endDate])
  @@index([sourceCampaignId])
}

enum CampaignType {
  TRANSACTION_BASED
  DEPOSIT_BASED
  ACCOUNT_OPENING
  MILESTONE
  REFERRAL
  HYBRID
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  ACTIVE
  DRAW_DAY
  DRAWN
  CLOSED
  CANCELLED
}

// ==================== CAMPAIGN APPROVAL ====================

model CampaignApproval {
  id          String         @id @default(uuid())
  campaignId  String
  level       Int
  status      ApprovalStatus @default(PENDING)
  approverId  String?
  comment     String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  campaign    Campaign       @relation(fields: [campaignId], references: [id])
  approver    User?          @relation(fields: [approverId], references: [id])

  @@unique([campaignId, level])
  @@index([status])
  @@index([campaignId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== CUSTOMER ENTRY ====================

model CustomerEntry {
  id                    String   @id @default(uuid())
  customerId            String
  campaignId            String
  accountId             String?
  entryType             EntryType
  entriesEarned         Int
  cumulativeEntries     Int
  triggerTransactionId  String?
  entryDate             DateTime @default(now())
  verified              Boolean  @default(false)
  verificationSource    String?
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())

  // Relations
  campaign              Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, customerId, triggerTransactionId])
  @@index([customerId])
  @@index([campaignId])
  @@index([entryDate])
}

enum EntryType {
  ACCOUNT_OPENED
  DEPOSIT
  FUND_TRANSFER
  MOBILE_TRANSACTION
  REFERRAL
  MILESTONE_ACHIEVED
  MANUAL
}

// ==================== PRIZE ====================

model Prize {
  id                      String   @id @default(uuid())
  campaignId              String
  rank                    Int
  name                    String
  category                PrizeCategory
  description             String?
  quantity                Int
  allocated               Int      @default(0)
  fulfilled               Int      @default(0)
  estimatedValue          Float
  currency                String   @default("USD")
  vendorName              String?
  vendorContact           Json?
  fulfillmentInstructions String?
  alternativesOffered     Json     @default("[]")
  termsAndConditions      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  campaign                Campaign @relation(fields: [campaignId], references: [id])
  winners                 DrawWinner[]

  @@index([campaignId])
  @@index([rank])
}

enum PrizeCategory {
  VEHICLE
  ELECTRONICS
  GOLD
  JEWELRY
  CASH
  TRAVEL
  SERVICE
  MERCHANDISE
}

// ==================== DRAW RESULT ====================

model DrawResult {
  id                String    @id @default(uuid())
  campaignId        String
  drawDate          DateTime
  drawType          String    @default("RANDOM")
  batchNumber       Int       @default(1)
  round             Int       @default(1)
  totalParticipants Int
  totalEntries      Int
  seed              String
  auditHash         String
  executedBy        String[]
  witnessedBy       String[]
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  // Relations
  campaign          Campaign  @relation(fields: [campaignId], references: [id])
  winners           DrawWinner[]

  @@index([campaignId])
  @@index([drawDate])
}

// ==================== DRAW WINNER ====================

model DrawWinner {
  id              String       @id @default(uuid())
  drawResultId    String
  customerId      String
  prizeId         String
  rank            Int
  entriesAtDraw   Int
  isAlternate     Boolean      @default(false)
  status          WinnerStatus @default(SELECTED)
  verifiedAt      DateTime?
  contactedAt     DateTime?
  acceptedAt      DateTime?
  fulfilledAt     DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  drawResult      DrawResult   @relation(fields: [drawResultId], references: [id])
  prize           Prize        @relation(fields: [prizeId], references: [id])
  claim           PrizeClaim?
  documents       Document[]

  @@index([customerId])
  @@index([prizeId])
  @@index([status])
}

// ==================== PRIZE CLAIM ====================

model PrizeClaim {
  id           String       @id @default(uuid())
  winnerId     String       @unique
  status       ClaimStatus  @default(SUBMITTED)
  claimedAt    DateTime?
  reviewedBy   String?
  reviewedAt   DateTime?
  decisionNote String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  winner       DrawWinner   @relation(fields: [winnerId], references: [id])
  documents    Document[]

  @@index([status])
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  FULFILLED
}

// ==================== DOCUMENT ====================

model Document {
  id          String         @id @default(uuid())
  claimId     String?
  winnerId    String
  type        DocumentType
  filePath    String
  mimeType    String
  size        Int
  status      DocumentStatus @default(PENDING)
  notes       String?
  uploadedAt  DateTime       @default(now())
  verifiedAt  DateTime?

  claim       PrizeClaim?    @relation(fields: [claimId], references: [id])
  winner      DrawWinner     @relation(fields: [winnerId], references: [id])

  @@index([claimId])
  @@index([winnerId])
  @@index([status])
}

enum DocumentType {
  ID_PROOF
  CLAIM_FORM
  TAX_FORM
  CONSENT
  PROOF_OF_ADDRESS
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WinnerStatus {
  SELECTED
  VERIFIED
  CONTACTED
  ACCEPTED
  DECLINED
  FULFILLED
  EXPIRED
}

// ==================== NOTIFICATION ====================

model Notification {
  id          String   @id @default(uuid())
  campaignId  String?
  customerId  String
  type        NotificationType
  channel     NotificationChannel
  subject     String?
  message     String
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  readAt      DateTime?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  // Relations
  campaign    Campaign? @relation(fields: [campaignId], references: [id])

  @@index([customerId])
  @@index([type])
  @@index([status])
}

enum NotificationType {
  WELCOME
  ENTRY_CONFIRMATION
  ENTRY_MILESTONE
  DRAW_REMINDER
  DRAW_DAY
  WINNER_ANNOUNCEMENT
  PRIZE_CLAIM
  GENERAL
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  performedBy String
  details     Json     @default("{}")
  ipAddress   String?
  createdAt   DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [performedBy], references: [id])

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt])
}
