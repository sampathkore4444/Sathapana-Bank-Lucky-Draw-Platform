# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luckydraw?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Server
PORT=3000
NODE_ENV=development
API_PREFIX="/api/v1"

# Core Banking Integration
CORE_BANKING_API_URL="https://corebanking.sathapana.com.kh/api/v1"
CORE_BANKING_API_KEY="your-core-banking-api-key"

# SMS Gateway
SMS_GATEWAY_URL="https://sms.sathapana.com.kh/api"
SMS_GATEWAY_API_KEY="your-sms-api-key"
SMS_GATEWAY_SENDER="SATHAPANA"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@sathapana.com.kh"
SMTP_PASS="your-smtp-password"

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# CORS
CORS_ORIGIN="http://localhost:3001"

# Logging
LOG_LEVEL="info"
